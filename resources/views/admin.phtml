<?php

declare(strict_types=1);

use Fisharebest\Webtrees\Http\RequestHandlers\ControlPanel;
use Fisharebest\Webtrees\Http\RequestHandlers\ModulesAllPage;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\View;

/**
 * @var string                                          $title
 * @var int                                             $max_degree
 * @var int                                             $limit
 * @var int                                             $early_age
 * @var int                                             $early_limit
 * @var array<string,string>                            $categories
 * @var array<string,array{category:string,icd:string}> $catalog
 * @var list<string>                                    $missing
 * @var int                                             $max_length
 * @var int                                             $category_max_length
 * @var string                                          $fallback_category
 * @var array<string,array{count:int,url:string}>       $usage
 */

// One row of the catalog table: name, category, ICD-10 code, individuals, delete. A name used in a tree but not in
// the catalog yet is marked.
$row = static function (int $i, string $name, string $category, string $icd, bool $is_new) use ($categories, $max_length, $usage): string {
    // A new row may stay without category - then it is not added.
    $options = $is_new ? '<option value=""></option>' : '';

    foreach ($categories as $id => $label) {
        $options .= '<option value="' . e($id) . '"' . ($id === $category ? ' selected' : '') . '>' . e($label) . '</option>';
    }

    // A name already in use remembers what it was, so renaming it can rename it for the individuals as well.
    $used     = $usage[mb_strtolower($name)] ?? null;
    $original = $name === '' ? '' : '<input type="hidden" name="entries[' . $i . '][original]" value="' . e($name) . '">';
    $data     = $used === null ? '' : ' data-original="' . e($name) . '" data-count="' . $used['count'] . '" data-url="' . e($used['url']) . '"';
    $count    = $used === null ? '0' : '<a href="' . e($used['url']) . '">' . I18N::number($used['count']) . '</a>';

    return '<tr' . ($is_new && $name !== '' ? ' class="table-warning"' : '') . '>'
        . '<td>' . $original . '<input class="form-control form-control-sm" name="entries[' . $i . '][name]" value="' . e($name) . '" maxlength="' . $max_length . '"' . $data . '></td>'
        . '<td><select class="form-select form-select-sm" name="entries[' . $i . '][category]">' . $options . '</select></td>'
        . '<td><input class="form-control form-control-sm" name="entries[' . $i . '][icd]" value="' . e($icd) . '" size="7" pattern="[A-Za-z][0-9]{2}(\.[0-9A-Za-z]{1,4})?"></td>'
        . '<td class="text-end" data-sort="' . ($used['count'] ?? 0) . '">' . ($name === '' ? '' : $count) . '</td>'
        . '<td>' . ($is_new ? '' : '<input class="form-check-input" type="checkbox" name="entries[' . $i . '][delete]" value="1" aria-label="' . e(I18N::translate('Delete')) . '">') . '</td>'
        . '</tr>';
};

$i = 0;

// All names in one list, alphabetical - the ones not in the catalog yet among them.
$rows = [];

foreach ($missing as $name) {
    $rows[] = [$name, '', '', true];
}

foreach ($catalog as $name => $entry) {
    $rows[] = [$name, $entry['category'], $entry['icd'], false];
}

usort($rows, static fn (array $x, array $y): int => I18N::comparator()($x[0], $y[0]));

?>

<?= view('components/breadcrumbs', ['links' => [route(ControlPanel::class) => I18N::translate('Control panel'), route(ModulesAllPage::class) => I18N::translate('Modules'), $title]]) ?>

<h1><?= e($title) ?></h1>

<form method="post" id="family-health-catalog">
    <?= csrf_field() ?>
    <input type="hidden" name="catalog_form" value="1">
    <input type="hidden" name="rename_individuals" value="" id="family-health-rename">

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="max_degree"><?= I18N::translate('Visible up to degree of relationship') ?></label>
        <div class="col-sm-9">
            <select class="form-select" id="max_degree" name="max_degree">
                <option value="0" <?= $max_degree === 0 ? 'selected' : '' ?>><?= I18N::translate('no limit') ?></option>
                <?php for ($degree = 1; $degree <= $limit; $degree++) : ?>
                    <option value="<?= $degree ?>" <?= $max_degree === $degree ? 'selected' : '' ?>><?= I18N::number($degree) ?></option>
                <?php endfor ?>
            </select>
            <div class="form-text"><?= I18N::translate('Illnesses are shown for blood relatives of your own individual and of your children under 18 – optionally only up to this degree.') ?></div>
        </div>
    </div>

    <div class="row mb-3">
        <label class="col-sm-3 col-form-label" for="early_age"><?= I18N::translate('Early onset below age') ?></label>
        <div class="col-sm-9">
            <input class="form-control" type="number" id="early_age" name="early_age" min="0" max="<?= $early_limit ?>" value="<?= $early_age ?>">
            <div class="form-text"><?= I18N::translate('In the family history, an illness diagnosed before this age is marked as early onset. 0 = do not mark.') ?></div>
        </div>
    </div>

    <h2 class="h4"><?= I18N::translate('Categories') ?></h2>
    <p class="form-text"><?= I18N::translate('Rename a category or add one. The illnesses of a deleted category go to “Other”.') ?></p>

    <table class="table table-sm align-middle w-auto">
        <thead>
            <tr>
                <th><?= I18N::translate('Category') ?></th>
                <th><?= I18N::translate('Delete') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php $c = 0 ?>
            <?php foreach ($categories as $id => $label) : ?>
                <tr>
                    <td>
                        <input type="hidden" name="categories[<?= $c ?>][id]" value="<?= e($id) ?>">
                        <input class="form-control form-control-sm" name="categories[<?= $c ?>][name]" value="<?= e($label) ?>" maxlength="<?= $category_max_length ?>" aria-label="<?= I18N::translate('Category') ?>">
                    </td>
                    <td>
                        <?php if ($id !== $fallback_category) : ?>
                            <input class="form-check-input" type="checkbox" name="categories[<?= $c ?>][delete]" value="1" aria-label="<?= I18N::translate('Delete') ?>">
                        <?php endif ?>
                    </td>
                </tr>
                <?php $c++ ?>
            <?php endforeach ?>
            <tr>
                <td>
                    <input type="hidden" name="categories[<?= $c ?>][id]" value="">
                    <input class="form-control form-control-sm" name="categories[<?= $c ?>][name]" value="" maxlength="<?= $category_max_length ?>" placeholder="<?= I18N::translate('New category') ?>" aria-label="<?= I18N::translate('New category') ?>">
                </td>
                <td></td>
            </tr>
        </tbody>
    </table>

    <h2 class="h4"><?= I18N::translate('Illness catalog') ?></h2>
    <p class="form-text"><?= I18N::translate('Each illness name with its category and, if you like, its ICD-10 code. The names are suggested when entering an illness, so the same illness is always spelled the same way.') ?></p>

    <?php if ($missing !== []) : ?>
        <div class="alert alert-warning"><?= I18N::translate('The marked names are used in a family tree but are not in the catalog yet. Choose a category to add them.') ?></div>
    <?php endif ?>

    <table class="table table-sm align-middle" id="family-health-catalog-table">
        <thead>
            <tr>
                <?php foreach ([I18N::translate('Illness'), I18N::translate('Category'), I18N::translate('ICD-10'), I18N::translate('Individuals')] as $column => $heading) : ?>
                    <th aria-sort="<?= $column === 0 ? 'ascending' : 'none' ?>"<?= $column === 3 ? ' class="text-end"' : '' ?>>
                        <button type="button" class="btn btn-link p-0 fw-bold text-decoration-none" data-sort-column="<?= $column ?>"><?= $heading ?> <span aria-hidden="true"><?= $column === 0 ? '▲' : '' ?></span></button>
                    </th>
                <?php endforeach ?>
                <th><?= I18N::translate('Delete') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($rows as [$name, $category, $icd, $is_new]) : ?>
                <?= $row($i++, $name, $category, $icd, $is_new) ?>
            <?php endforeach ?>
            <?= $row($i++, '', '', '', true) ?>
        </tbody>
    </table>

    <button type="submit" class="btn btn-primary"><?= I18N::translate('save') ?></button>
</form>

<dialog id="family-health-rename-dialog" class="border rounded shadow p-4" style="max-width: 40rem;"
        data-individuals="<?= e(I18N::translate('individuals: %s', '%s')) ?>" data-show="<?= e(I18N::translate('Show the individuals')) ?>">
    <h2 class="h5"><?= I18N::translate('Rename these illnesses for all individuals as well?') ?></h2>
    <ul id="family-health-rename-list"></ul>
    <p class="form-text"><?= I18N::translate('Otherwise only the catalog changes, and the individuals keep the old name – without a category.') ?></p>
    <div class="d-flex flex-wrap gap-2 justify-content-end">
        <button type="button" class="btn btn-secondary" data-choice=""><?= I18N::translate('cancel') ?></button>
        <button type="button" class="btn btn-outline-primary" data-choice="0"><?= I18N::translate('Only in the catalog') ?></button>
        <button type="button" class="btn btn-primary" data-choice="1"><?= I18N::translate('Rename for all individuals') ?></button>
    </div>
</dialog>

<?php View::push('javascript') ?>
<script>
(() => {
    const form = document.getElementById('family-health-catalog');
    const dialog = document.getElementById('family-health-rename-dialog');
    const list = document.getElementById('family-health-rename-list');
    let isConfirmed = false;

    form.addEventListener('submit', (event) => {
        if (isConfirmed || typeof dialog.showModal !== 'function') {
            return;
        }

        const renames = [...form.querySelectorAll('input[data-original]')].filter((input) => {
            const remove = input.closest('tr').querySelector('input[type=checkbox]');

            return input.value.trim() !== '' && input.value.trim() !== input.dataset.original && !(remove && remove.checked);
        });

        if (renames.length === 0) {
            return;
        }

        event.preventDefault();
        list.replaceChildren(...renames.map((input) => {
            const item = document.createElement('li');
            const anchor = document.createElement('a');

            anchor.href = input.dataset.url;
            anchor.target = '_blank';
            anchor.textContent = dialog.dataset.show;
            item.append('„' + input.dataset.original + '“ → „' + input.value.trim() + '“ – ' + dialog.dataset.individuals.replace('%s', input.dataset.count) + ' · ', anchor);

            return item;
        }));
        dialog.showModal();
    });

    dialog.querySelectorAll('[data-choice]').forEach((button) => button.addEventListener('click', () => {
        dialog.close();

        if (button.dataset.choice !== '') {
            document.getElementById('family-health-rename').value = button.dataset.choice;
            isConfirmed = true;
            form.requestSubmit();
        }
    }));

    // Sort the catalog by a column; the empty row for a new name stays last.
    const table = document.getElementById('family-health-catalog-table');
    const body = table.tBodies[0];
    const collator = new Intl.Collator(document.documentElement.lang || undefined, {numeric: true, sensitivity: 'base'});
    const value = (row, column) => {
        const cell = row.cells[column];
        const select = cell.querySelector('select');

        if (column === 3) {
            return Number(cell.dataset.sort);
        }

        return select ? select.options[select.selectedIndex]?.text ?? '' : cell.querySelector('input:not([type=hidden])')?.value ?? '';
    };

    table.querySelectorAll('[data-sort-column]').forEach((button) => button.addEventListener('click', () => {
        const column = Number(button.dataset.sortColumn);
        const heading = button.closest('th');
        const isAscending = heading.getAttribute('aria-sort') !== 'ascending';
        const rows = [...body.rows];
        const last = rows.pop();

        rows.sort((x, y) => {
            const a = value(x, column);
            const b = value(y, column);
            const order = typeof a === 'number' ? a - b : collator.compare(a, b);

            return (isAscending ? order : -order) || collator.compare(value(x, 0), value(y, 0));
        });
        body.replaceChildren(...rows, last);

        table.querySelectorAll('th[aria-sort]').forEach((th) => {
            th.setAttribute('aria-sort', 'none');
            th.querySelector('span').textContent = '';
        });
        heading.setAttribute('aria-sort', isAscending ? 'ascending' : 'descending');
        heading.querySelector('span').textContent = isAscending ? '▲' : '▼';
    }));
})();
</script>
<?php View::endpush() ?>
