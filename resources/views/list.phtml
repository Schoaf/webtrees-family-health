<?php

declare(strict_types=1);

use FamilyHealth\Catalog;
use Fisharebest\Webtrees\Date;
use Fisharebest\Webtrees\I18N;
use Fisharebest\Webtrees\Individual;
use Fisharebest\Webtrees\Tree;

/**
 * @var string                                                                       $title
 * @var Tree                                                                         $tree
 * @var bool                                                                         $is_linked
 * @var list<array{individual:Individual,illness:string,category:string,date:string,degree:int}> $illnesses
 * @var bool                                                                         $can_add
 * @var Individual|null                                                              $own
 * @var array<string,array{category:string,icd:string}>                              $catalog
 * @var string                                                                       $add_url
 * @var array<string,string>                                                         $categories
 * @var string                                                                       $history_url
 * @var string                                                                       $module_name
 */

$category_names = Catalog::categoryNames();

?>

<h2 class="wt-page-title"><?= e($title) ?></h2>

<?php if ($is_linked) : ?>
    <p><a class="btn btn-secondary" href="<?= e($history_url) ?>"><?= I18N::translate('Family health history') ?></a></p>
<?php endif ?>

<?php if (!$is_linked) : ?>
    <div class="alert alert-info"><?= I18N::translate('Your account is not linked to an individual in this family tree, so there are no relatives to show. An administrator can link it.') ?></div>
<?php elseif ($illnesses === []) : ?>
    <p><?= I18N::translate('No illnesses are recorded for your blood relatives.') ?></p>
<?php else : ?>
    <table class="table table-sm wt-family-health">
        <thead>
            <tr>
                <th><?= I18N::translate('Individual') ?></th>
                <th><?= I18N::translate('Degree') ?></th>
                <th><?= I18N::translate('Illness') ?></th>
                <th><?= I18N::translate('Category') ?></th>
                <th><?= I18N::translate('Date') ?></th>
            </tr>
        </thead>
        <tbody>
            <?php foreach ($illnesses as $entry) : ?>
                <tr>
                    <td><a href="<?= e($entry['individual']->url()) ?>"><?= $entry['individual']->fullName() ?></a></td>
                    <td><?= I18N::number($entry['degree']) ?></td>
                    <td><?= e($entry['illness']) ?></td>
                    <td><?= e($category_names[$entry['category']]) ?></td>
                    <td><?= $entry['date'] === '' ? '' : (new Date($entry['date']))->display() ?></td>
                </tr>
            <?php endforeach ?>
        </tbody>
    </table>
<?php endif ?>

<?php if ($can_add) : ?>
    <h3 class="h5 mt-4"><?= I18N::translate('Record an illness') ?></h3>
    <?= view($module_name . '::record-form', ['tree' => $tree, 'individual' => $own, 'is_individual_fixed' => false, 'catalog' => $catalog, 'categories' => $categories, 'add_url' => $add_url]) ?>
<?php endif ?>
